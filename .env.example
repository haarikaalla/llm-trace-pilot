# ── AgentScope core ──────────────────────────────────────────────────────────
# AGENTSCOPE_DB=./agentscope.db          # LLM traces / evals / prompts (SQLite)

# ── Observability platform backends ─────────────────────────────────────────
# EVENT_BUS=memory                       # memory | kafka
# LOG_INDEX=sqlite                       # sqlite | opensearch
# OBSERVABILITY_DB=./agentscope.db       # SQLite log index + incidents (defaults to AGENTSCOPE_DB)

# KAFKA_BOOTSTRAP=localhost:9092
# KAFKA_GROUP_ID=agentscope
# OPENSEARCH_URL=http://localhost:9200
# OPENSEARCH_USER=
# OPENSEARCH_PASSWORD=
# OPENSEARCH_INDEX_PREFIX=logs

# ── Pipeline / detection ─────────────────────────────────────────────────────
# PIPELINE_BATCH_SIZE=500
# REDACT_PII=true
# DETECTION_WINDOW_SEC=60
# DETECTION_HISTORY_WINDOWS=30
# ANOMALY_THRESHOLD=0.7
# DETECTOR_INTERVAL_SEC=30

# ── Alerting / AI ────────────────────────────────────────────────────────────
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# ALERT_DEDUP_SEC=300
# INCIDENT_GROUP_WINDOW_SEC=600
# AI_SUMMARIES=true
# SUMMARY_MODEL=llama3.2
# OLLAMA_URL=http://localhost:11434/api/generate

# ── Security ─────────────────────────────────────────────────────────────────
# INGEST_API_KEY=                        # required header X-Api-Key on /v1/ingest* when set
